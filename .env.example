# Browser-safe Supabase project settings (the publishable/anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. If empty, the browser connects to the API on the same host as the site.
VITE_API_URL=

# Server settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Supabase secret/service-role key. Never expose to the browser.
SUPABASE_SECRET_KEY=
PORT=4000
# Comma-separated list of allowed site origins; add the LAN URL when using another device.
CLIENT_ORIGIN=http://localhost:5173

# Contact email notifications (Google App Password; never your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# Use a long random value generated specifically for analytics pseudonymization
ANALYTICS_HASH_SECRET=
